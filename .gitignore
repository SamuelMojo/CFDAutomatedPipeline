.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
jobs/
*.report.json

# Never commit downloaded or third-party geometry or data; list sources in test_data/README.md
test_data/*
!test_data/README.md
*.step
*.stp
*.STEP
*.STP

# Large renders and OpenFOAM output
*.mp4
*.foam
processor*/

# Terraform: never commit state or real variable files (.terraform.lock.hcl IS committed)
aws/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# The AWS web front end (cfd.samuelojo.tech) stays out of the repo until it is deployed and working.
# Remove this line to publish it.
aws/
