.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
jobs/
*.report.json

# Never commit downloaded or third-party geometry or data; list sources in test_data/README.md
test_data/*
!test_data/README.md
*.step
*.stp
*.STEP
*.STP

# Large renders and OpenFOAM output
*.mp4
*.foam
processor*/

# Terraform: never commit state, saved plans, real variable files or the zipped Lambda code
# (.terraform.lock.hcl and terraform.tfvars.example ARE committed)
aws/terraform/.terraform/
aws/terraform/.build/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log
